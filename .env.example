# DoVedioPlus 环境变量配置
# 复制此文件为 .env 并填入真实值

# 应用端口
APP_PORT=9090

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=root

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=media

# AI API 密钥
DEEPSEEK_API_KEY=sk-填你的密钥
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
ALIYUN_API_KEY=sk-填你的密钥

# JWT
JWT_SECRET=请生成随机字符串替换此处
JWT_EXPIRATION=86400000

# 工具路径
YTDLP_PATH=D:/yt-dlp/yt-dlp.exe
FFMPEG_DIR=D:/ffmpeg/bin

# RocketMQ
ROCKETMQ_HOST=127.0.0.1:9876
